{
  "name": "xnote",
  "version": "0.1.0",
  "description": "A minimal markdown notes app with spaced repetition",
  "main": "./out/main/index.js",
  "author": "seannelson929",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:dir": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/verify.cjs",
    "check:repo": "node scripts/check-repo.cjs",
    "test:package": "node scripts/check-package.cjs",
    "verify": "npm run check:repo && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@floating-ui/react": "^0.27.20",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@open-spaced-repetition/binding": "^0.5.0",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.7.76",
    "perfect-freehand": "^1.2.3",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "^5.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
